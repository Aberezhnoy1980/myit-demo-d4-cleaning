# Шаблон, не авторизация. Заполнить локально только после независимого ревью.
# Собственный .env: права 0600, без кавычек, export, подстановок или inline-комментариев.
# Токен/ID группы не передавать в чат или аргументы команд.
D4_TELEGRAM_TOKEN=
D4_TELEGRAM_CHAT_ID=
# По умолчанию live выключен. 1 — только после отдельного согласования операции.
D4_TELEGRAM_LIVE=0
