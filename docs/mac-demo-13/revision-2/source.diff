+def pem():
+    result = subprocess.run([OPENSSL, 'genpkey', '-algorithm', 'RSA', '-pkeyopt', 'rsa_keygen_bits:2048'],
+                            capture_output=True, timeout=15, check=True)
+    return result.stdout
+
