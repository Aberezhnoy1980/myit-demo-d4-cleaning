+:root {
+  --paper: #faf7f0;
+  --ink: #304638;
+  --green: #49664f;
+  --muted: #5f6c60;
+  --line: #d9dfd2;
+  --sage: #eaf0e5;
+  --peach: #f3ddcd;
+  --error: #a33329;
+  --serif: Georgia, 'Times New Roman', serif;
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+  font-synthesis: none;
+}
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; scroll-padding-top: 24px; }
+body { margin: 0; }
+a { color: inherit; text-underline-offset: 4px; }
+button, input, select, textarea { font: inherit; }
+button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
+button { cursor: pointer; }
+a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible,
+textarea:focus-visible, [tabindex]:focus-visible {
+  outline: 3px solid #a65b31;
+  outline-offset: 5px;
+}
+p { line-height: 1.65; }
+h1, h2, h3, p, figure { margin: 0; }
+h1, h2, h3 { font-family: var(--serif); font-weight: 400; letter-spacing: -.018em; }
+h2 { font-size: clamp(34px, 3.4vw, 48px); line-height: 1.17; }
+.wrap { max-width: 1248px; width: calc(100% - 96px); margin-inline: auto; }
+.icon { width: 24px; height: 24px; flex-shrink: 0; fill: none; stroke: currentColor; }
+.demo-bar { padding: 11px 20px; background: var(--sage); font-size: 13px; line-height: 1.5; text-align: center; }
+.demo-bar span { margin: 0 7px; }
+.header { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 27px 0; }
+.brand { display: flex; align-items: center; gap: 11px; text-decoration: none; font-family: var(--serif); font-size: 26px; letter-spacing: -.02em; }
+.brand small { display: block; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; font-size: 12px; letter-spacing: .04em; margin-top: 5px; }
+.header nav { display: flex; align-items: center; gap: 32px; font-size: 15px; }
+.header nav a { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; padding: 12px 0; }
+.header nav a:last-child { border-bottom: 1px solid var(--ink); }
+.hero { display: grid; grid-template-columns: .98fr 1.02fr; gap: 55px; padding: 20px 0 64px; }
+.hero-copy { display: flex; align-items: flex-start; flex-direction: column; padding-top: 30px; }
+.eyebrow { font-size: 12px; letter-spacing: .1em; font-weight: 600; line-height: 1.5; }
+.dot { display: inline-block; background: #93a586; width: 8px; height: 8px; border-radius: 50%; margin-right: 10px; }
+h1 { font-size: clamp(44px, 4.6vw, 64px); line-height: 1.1; margin: 26px 0; }
+h1 em { color: #708465; font-weight: 400; }
+.intro { font-size: 18px; color: var(--muted); }
+.button { display: inline-flex; align-items: center; justify-content: space-between; gap: 22px; min-height: 56px; padding: 16px 23px; color: #fffef8; background: var(--green); border: 1px solid var(--green); border-radius: 14px; text-decoration: none; font-size: 16px; line-height: 1.5; font-weight: 500; transition: background .15s; }
+.button:hover { background: #344e3a; }
+.hero .button { margin-top: 29px; }
+.fine { font-size: 14px; line-height: 1.6; color: var(--muted); }
+.hero-fine { margin-top: 14px; max-width: 430px; }
+.hero-bottom { display: flex; gap: 14px; align-items: center; margin-top: auto; padding-top: 30px; font-size: 15px; }
+.hero-bottom > .icon { width: 40px; height: 40px; padding: 7px; background: var(--peach); border-radius: 13px; }
+.hero-bottom strong { font-weight: 500; }
+.hero-photo { height: 640px; background: #e5e1d6; position: relative; overflow: hidden; border-radius: 28px 28px 18px 18px; }
+.hero-photo > img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 54%; }
+.photo-tag { position: absolute; left: 24px; top: 24px; background: rgba(250,247,240,.95); display: flex; gap: 12px; align-items: center; padding: 15px 18px; border-radius: 14px; font-size: 14px; line-height: 1.5; }
+.hero-photo figcaption { position: absolute; bottom: 16px; left: 20px; right: 20px; width: fit-content; max-width: calc(100% - 40px); padding: 7px 10px; background: rgba(250,247,240,.96); font-size: 12px; border-radius: 8px; }
+.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 35px; margin-bottom: 32px; }
+.section-heading h2 { margin-top: 16px; }
+.section-heading > p { max-width: 360px; color: var(--muted); font-size: 16px; }
+.examples { padding: 56px 0 68px; border-top: 1px solid var(--line); }
+.examples-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
+.comparison { padding: 22px; background: #fffdf8; border: 1px solid var(--line); border-radius: 20px; min-width: 0; }
+.comparison h3 { font-size: 26px; }
+.comparison > p { color: var(--muted); font-size: 14px; margin-top: 7px; }
+.comparison-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 22px 0 16px; }
+.comparison-pair figure { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
+.comparison-pair img { display: block; width: 100%; height: auto; border-radius: 12px; }
+.comparison-pair figcaption { width: fit-content; font-size: 14px; padding: 4px 12px; border-radius: 20px; background: var(--sage); }
+.comparison-pair figure:first-child figcaption { background: #f3e5d9; }
+.comparison .comparison-note { font-size: 14px; }
+.examples-disclaimer { margin-top: 22px; font-size: 14px; color: var(--muted); max-width: 780px; }
+.approach { padding: 55px 0 76px; border-top: 1px solid var(--line); }
+.process { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; list-style: none; padding: 0; margin: 0; }
+.process li { min-width: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 20px; background: #fffdf8; }
+.process img { display: block; width: 100%; height: auto; background: #f0f2e9; }
+.step-copy { padding: 20px 20px 25px; }
+.step-number { display: inline-block; margin-bottom: 15px; font-size: 13px; color: var(--muted); }
+.process h3 { font-size: 24px; line-height: 1.25; margin-bottom: 13px; }
+.process p { font-size: 15px; color: var(--muted); }
+.care-section { background: var(--sage); padding: 68px 0; }
+.care-layout { display: grid; grid-template-columns: 1.1fr 1fr; gap: 80px; }
+.care-layout h2 { margin: 18px 0 22px; }
+.care-intro { color: var(--muted); max-width: 520px; font-size: 17px; }
+.care-points { list-style: none; margin: 26px 0 0; padding: 0; }
+.care-points li { position: relative; padding: 0 0 16px 25px; font-size: 16px; line-height: 1.6; }
+.care-points li::before { content: ''; position: absolute; top: 8px; left: 0; height: 8px; width: 8px; background: #8da17f; border-radius: 3px; }
+.questions { align-self: center; }
+.questions details { border-bottom: 1px solid #bfcdb9; padding: 21px 0; }
+.questions summary { cursor: pointer; font-family: var(--serif); font-size: 23px; line-height: 1.3; padding: 4px 10px 4px 0; }
+.questions summary:focus-visible { outline: 3px solid #a65b31; outline-offset: 4px; }
+.questions p { font-size: 16px; color: var(--muted); padding-top: 17px; }
+.offer { display: grid; grid-template-columns: 230px 1fr auto; align-items: center; gap: 26px; padding: 35px; margin-top: 64px; margin-bottom: 64px; background: #f6e8db; border: 1px solid #e8d3be; border-radius: 24px; }
+.offer > img { display: block; width: 100%; height: auto; }
+.offer-label { display: inline-block; font-size: 12px; line-height: 1.5; color: #73543e; }
+.offer h2 { margin: 15px 0; font-size: 38px; }
+.offer p { font-size: 17px; }
+.button-light { color: var(--ink); background: #fffaf3; border-color: #bba58f; }
+.button-light:hover { background: #f9f1e6; }
+.request-section { background: #edf1e8; padding: 76px 0; }
+.request-layout { display: grid; grid-template-columns: .9fr 1.1fr; gap: 70px; align-items: start; }
+.request-copy h2 { font-size: 48px; margin: 20px 0 25px; }
+.request-copy > p:not(.eyebrow) { font-size: 18px; color: var(--muted); }
+.request-note { display: flex; gap: 15px; margin-top: 38px; border-top: 1px solid #c5cdbf; padding-top: 24px; max-width: 410px; }
+.request-note > .icon { margin-top: 2px; }
+.request-note p { font-size: 15px; color: var(--muted); }
+.request-note strong { display: inline-block; font-size: 17px; font-weight: 500; color: var(--ink); margin-bottom: 7px; }
+.request-copy .demo-note { font-size: 14px !important; max-width: 410px; margin-top: 30px; }
+.demo-note strong { font-weight: 600; }
+form { min-width: 0; background: #fffdf8; border: 1px solid #d8dfce; border-radius: 22px; padding: 32px; }
+.form-top { display: flex; gap: 15px; justify-content: space-between; align-items: center; margin-bottom: 10px; }
+.form-top h3 { font-size: 28px; }
+.form-top > span { border: 1px solid #c9d1c1; border-radius: 7px; padding: 5px 7px; font-size: 11px; letter-spacing: .08em; }
+fieldset { padding: 0; margin: 28px 0 0; border: 0; min-width: 0; }
+legend { font-size: 17px; font-weight: 500; padding: 0; margin-bottom: 18px; display: flex; align-items: center; gap: 10px; width: 100%; }
+legend > span { display: inline-grid; place-items: center; border: 1px solid #bec9b5; border-radius: 50%; width: 26px; height: 26px; font-size: 13px; flex-shrink: 0; }
+.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
+.field { margin-bottom: 18px; min-width: 0; }
+label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 9px; }
+input:not([type=file]), select, textarea { width: 100%; border: 1px solid #b7c4ad; border-radius: 10px; background: #fffefb; color: var(--ink); padding: 13px 12px; font-size: 16px; min-height: 48px; }
+select { padding-right: 30px; }
+textarea { resize: vertical; line-height: 1.6; min-height: 125px; }
+textarea::placeholder, input::placeholder { color: #697468; opacity: 1; }
+.field-meta { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; line-height: 1.5; color: var(--muted); margin-top: 8px; }
+.field-meta > span:last-child { white-space: nowrap; }
+.field-error { font-size: 14px; color: var(--error); margin-top: 9px; line-height: 1.5; }
+[aria-invalid=true] { border-color: var(--error) !important; background: #fff9f6 !important; }
+.photo-help { margin: -3px 0 14px; }
+.upload-box { border: 1px dashed #94a88a; text-align: center; border-radius: 14px; padding: 22px 12px; position: relative; background: #f2f5ed; }
+.upload-box > .icon { display: block; width: 32px; height: 32px; margin: 0 auto 12px; }
+.upload-box label { font-size: 16px; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
+.upload-box input[type=file] { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
+.upload-box:focus-within { outline: 3px solid #a65b31; outline-offset: 5px; }
+.upload-box input:disabled { cursor: wait; }
+.upload-box p { font-size: 13px; color: var(--muted); }
+.previews { display: flex; gap: 10px; list-style: none; padding: 0; margin: 14px 0 0; flex-wrap: wrap; }
+.previews:empty { display: none; }
+.previews li { border: 1px solid var(--line); padding: 7px; width: calc((100% - 20px) / 3); min-width: 80px; border-radius: 10px; }
+.previews img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 5px; }
+.previews p { font-size: 12px; overflow-wrap: anywhere; margin: 7px 0; }
+.previews button { font-size: 13px; color: var(--ink); background: none; border: 0; padding: 8px 0; text-decoration: underline; }
+.contact-row { grid-template-columns: 1fr 1.2fr; }
+fieldset:last-of-type > .fine { margin-top: -5px; }
+.submit { width: 100%; margin-top: 18px; text-align: left; }
+.submit-note { margin-top: 24px; font-size: 14px; }
+.error-summary { background: #fff1e8; border-left: 3px solid var(--error); border-radius: 10px; color: #82251f; padding: 18px; margin-top: 20px; font-size: 15px; line-height: 1.6; }
+.error-summary ul { margin: 8px 0 0; padding-left: 20px; }
+.error-summary a { color: inherit; }
+.error-summary p { margin-top: 8px; }
+.result { overflow-wrap: anywhere; background: #e8f0e2; border-left: 3px solid var(--green); border-radius: 12px; padding: 22px; margin-top: 20px; font-size: 16px; }
+.result p { margin: 12px 0; }
+.result button { background: none; border: 0; color: var(--green); padding: 12px 0; text-decoration: underline; text-align: left; }
+.result code { font-size: 14px; }
+.sample-button { background: none; border: 0; color: var(--green); padding: 14px 0; text-decoration: underline; font-size: 15px; text-align: left; }
+.button:disabled { opacity: .65; cursor: wait; }
+#sending { margin-top: 14px; text-align: center; }
+footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 35px 0; }
+footer > span { display: inline-flex; gap: 10px; align-items: center; font-family: var(--serif); font-size: 23px; }
+footer p { font-size: 13px; color: var(--muted); }
+footer a { font-size: 14px; padding: 12px 0; }
+.skip { position: fixed; top: -100px; left: 20px; padding: 15px; background: white; z-index: 10; }
+.skip:focus { top: 15px; }
+[hidden] { display: none !important; }
+@media (max-width: 1100px) {
+  .wrap { width: calc(100% - 64px); }
+  .hero { gap: 30px; }
+  .hero-copy { padding-top: 20px; }
+  h1 { font-size: 49px; }
+  .hero-photo { height: 630px; }
+  .desktop-break { display: none; }
+  .offer { grid-template-columns: 170px 1fr; }
+  .offer > .button { grid-column: 2; justify-self: start; }
+  .offer > img { grid-row: span 2; }
+  .request-layout { gap: 40px; }
+  .request-copy h2 { font-size: 40px; }
+  form { padding: 26px; }
+  .process { grid-template-columns: 1fr 1fr; gap: 24px; }
+  .care-layout { gap: 40px; }
+}
+@media (max-width: 900px) {
+  .wrap { width: calc(100% - 48px); }
+  .header nav { gap: 20px; font-size: 14px; }
+  .hero { gap: 24px; }
+  h1 { font-size: 42px; }
+  .intro { font-size: 17px; }
+  .hero .button { padding: 15px; font-size: 15px; gap: 12px; }
+  .hero-photo { height: 650px; }
+  .photo-tag { top: 16px; left: 16px; padding: 12px; font-size: 13px; }
+  .hero-bottom { font-size: 14px; }
+  .examples-grid { grid-template-columns: 1fr; }
+  .section-heading { align-items: start; }
+  .section-heading > p { max-width: 260px; }
+  .care-layout, .request-layout { grid-template-columns: 1fr; gap: 35px; }
+  .care-intro, .request-copy .demo-note, .request-note { max-width: none; }
+  .request-copy h2 br, .request-copy > p br { display: none; }
+  .request-copy .demo-note { margin-top: 22px; }
+  .request-note { margin-top: 24px; }
+  form { padding: 30px; }
+}
+@media (max-width: 600px) {
+  .wrap { width: calc(100% - 40px); }
+  .demo-bar { font-size: 12px; padding: 10px 12px; }
+  .demo-bar span { margin: 0 4px; }
+  .header { padding: 21px 0; gap: 12px; }
+  .brand { font-size: 21px; gap: 8px; white-space: nowrap; }
+  .brand img { width: 32px; height: 32px; }
+  .brand small { font-size: 11px; }
+  .header nav a:first-child { display: none; }
+  .header nav { font-size: 13px; flex-shrink: 0; }
+  .header nav .icon { display: none; }
+  .hero { display: flex; flex-direction: column; gap: 28px; padding: 12px 0 38px; }
+  .hero-copy { padding-top: 5px; }
+  .eyebrow { font-size: 11px; }
+  h1 { font-size: clamp(36px, 10vw, 42px); margin: 20px 0; line-height: 1.13; }
+  .intro { font-size: 17px; }
+  .hero .button { font-size: 16px; padding: 16px 20px; width: 100%; margin-top: 25px; }
+  .hero-fine { font-size: 13px; max-width: none; margin-top: 14px; }
+  .hero-bottom { display: none; }
+  .hero-photo { height: 360px; border-radius: 22px; }
+  .hero-photo > img { object-position: 50% 57%; }
+  .hero-photo figcaption { font-size: 11px; left: 12px; bottom: 12px; padding: 6px 9px; max-width: calc(100% - 24px); }
+  .photo-tag { top: 15px; left: 15px; padding: 12px; font-size: 13px; gap: 10px; }
+  h2 { font-size: 34px; }
+  .section-heading { flex-direction: column; gap: 20px; margin-bottom: 26px; }
+  .section-heading > p { max-width: none; }
+  .section-heading > p br { display: none; }
+  .examples, .approach { padding: 38px 0 44px; }
+  .comparison { padding: 18px; }
+  .comparison h3 { font-size: 25px; }
+  .comparison-pair { grid-template-columns: 1fr; gap: 20px; }
+  .comparison-pair figure { position: relative; gap: 0; }
+  .comparison-pair figcaption { position: absolute; top: 10px; left: 10px; background: #edf2e6; border: 1px solid #d1dcc9; font-weight: 500; }
+  .comparison-pair figure:first-child figcaption { background: #f5e9dd; border-color: #ead7c4; }
+  .examples-disclaimer { font-size: 14px; }
+  .process { grid-template-columns: 1fr; gap: 20px; }
+  .process li { display: grid; grid-template-columns: .85fr 1.15fr; align-items: center; }
+  .process img { height: 100%; object-fit: contain; }
+  .step-copy { padding: 22px 16px 22px 5px; }
+  .step-number { margin-bottom: 10px; }
+  .process h3 { font-size: 22px; }
+  .process p { font-size: 15px; }
+  .care-section { padding: 42px 0; }
+  .care-layout { gap: 25px; }
+  .care-layout h2 br { display: none; }
+  .questions summary { font-size: 23px; }
+  .offer { display: flex; flex-direction: column; align-items: start; gap: 22px; padding: 25px; margin-top: 40px; margin-bottom: 40px; }
+  .offer > img { width: 180px; align-self: center; }
+  .offer h2 { font-size: 34px; }
+  .offer-label { font-size: 13px; }
+  .offer > .button { width: 100%; }
+  .request-section { padding: 42px 0; }
+  .request-layout { gap: 28px; }
+  .request-copy h2 { font-size: 36px; margin: 16px 0 20px; }
+  .request-copy > p:not(.eyebrow) { font-size: 17px; }
+  form { padding: 25px 18px; border-radius: 18px; }
+  .form-top h3 { font-size: 26px; }
+  .form-top > span { font-size: 10px; }
+  .form-row, .contact-row { grid-template-columns: 1fr; gap: 0; }
+  .fine { font-size: 14px; }
+  legend { font-size: 16px; }
+  input:not([type=file]), select, textarea { font-size: 16px; }
+  .field-meta { flex-wrap: wrap; font-size: 12px; }
+  .field-meta > span:last-child { margin-left: auto; }
+  .submit { font-size: 15px; gap: 12px; padding: 15px; }
+  .submit-note { font-size: 14px; }
+  .result { padding: 18px; font-size: 15px; }
+  footer { flex-wrap: wrap; padding: 28px 0; gap: 20px; }
+  footer p { order: 3; width: 100%; font-size: 13px; }
+  footer > span { font-size: 22px; }
+}
+@media (max-width: 375px) {
+  .header { flex-wrap: wrap; gap: 8px; }
+  .header nav { margin-left: 40px; }
+  .header nav a { padding: 5px 0; }
+  .process li { grid-template-columns: 1fr; }
+  .process img { height: 160px; }
+  .step-copy { padding: 0 22px 25px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { transition: none !important; animation: none !important; }
+}
